{
    "name": "thuto-agentic-loop",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc",
        "test:llm:live": "tsx --test llm-maze-exploration-agent/tests/integration/llm-live.test.ts",
        "test": "tsx --test {maze-exploration-agent,llm-maze-exploration-agent,secret-number}/**/*.test.ts",
        "typecheck": "tsc --noEmit",
        "visualization:build": "esbuild visualization/controller.ts --bundle --platform=browser --format=iife --outfile=visualization/app.js",
        "visualization:start": "npm run visualization:build && tsx visualization/server.ts",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "format": "biome format --write ."
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.8",
        "@types/node": "latest",
        "tsx": "latest",
        "typescript": "latest"
    },
    "dependencies": {
        "openai": "^7.5.0"
    }
}
