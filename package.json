{
    "name": "thuto-agentic-loop",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.0",
    "workspaces": [
        "01-secret-number-exit-condition-loop",
        "02-secret-number-reason-act-observe-loop",
        "03-maze-determistic",
        "04-maze-llm-agent",
        "05-maze-conversation-history-agent"
    ],
    "engines": {
        "bun": ">=1.4.0"
    },
    "scripts": {
        "build": "tsc",
        "test:llm:live": "bun --filter @thuto/maze-llm-agent run test:live",
        "test": "bun --filter @thuto/secret-number-exit-condition-loop --filter @thuto/secret-number-reason-act-observe-loop --filter @thuto/maze-deterministic --filter @thuto/maze-llm-agent test",
        "typecheck": "tsc --noEmit",
        "visualization:build": "bun build visualizations/maze-visualization/controller.ts --target browser --format iife --outfile visualizations/maze-visualization/app.js",
        "visualization:start": "bun run visualization:build && bun visualizations/maze-visualization/server.ts",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "format": "biome format --write ."
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.8",
        "@types/node": "latest",
        "typescript": "latest"
    }
}
